<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="FastmathResultsView" parent="AdwNavigationPage">
    <property name="title" translatable="yes">Results</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="GtkLabel" id="score_label">
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <style>
                      <class name="score"/>
                      <class name="numeric"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="config_label">
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Correct</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="correct_label">
                        <style>
                          <class name="numeric"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Wrong</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="wrong_label">
                        <style>
                          <class name="numeric"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Unanswered</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="unanswered_label">
                        <style>
                          <class name="numeric"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Average Time per Answer</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="average_label">
                        <style>
                          <class name="numeric"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="save_group">
                <property name="visible">false</property>
                <property name="title" translatable="yes">New High Score</property>
                <property name="description" translatable="yes">Enter your name to add this score to the leaderboard</property>
                <child>
                  <object class="AdwEntryRow" id="name_row">
                    <property name="title" translatable="yes">Name</property>
                    <property name="show-apply-button">true</property>
                    <property name="max-length">30</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="leaderboard_group">
                <property name="title" translatable="yes">Leaderboard</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="GtkBox">
                    <property name="halign">center</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkButton" id="back_button">
                        <property name="label" translatable="yes">_Back</property>
                        <property name="use-underline">true</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="retry_button">
                        <property name="label" translatable="yes">_Play Again</property>
                        <property name="use-underline">true</property>
                        <style>
                          <class name="suggested-action"/>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
